"use server";
import { defineFormAction, displayMessage } from "@omer-x/next-form-actions";
import { updateTag } from "next/cache";
import { z } from "zod/v4";
import { destroy{{ pascalCase modelName }}, insert{{ pascalCase modelName }}, patch{{ pascalCase modelName }} } from "~/data/mutations/{{ kebabCase modelName }}";
{{#if i18n}}
import { type AppLocale, redirect } from "~/i18n/routing";
{{else}}
import { redirect } from "next/navigation";
{{/if}}
import { mustBeLoggedIn } from "./middlewares/session";

export const create{{ pascalCase modelName }} = defineFormAction({
  middlewares: [mustBeLoggedIn],
  schema: schemaOfNew{{ pascalCase modelName }}DTO,
  action: input => (async ({{#if i18n}}locale: AppLocale{{/if}}) => {
    try {
      await insert{{ pascalCase modelName }}(input);
    } catch (error) {
      if (error === "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX") {
        displayMessage("error", error);
      }
      throw error;
    }
    updateTag("get{{ pascalCase modelName }}Ids(...)");
    {{#if i18n}}
    return redirect({
      locale,
      href: "/{{ kebabCase modelName "plural" }}",
    });
    {{else}}
    return redirect("/{{ kebabCase modelName "plural" }}");
    {{/if}}
  }),
});

export const update{{ pascalCase modelName }} = defineFormAction({
  middlewares: [mustBeLoggedIn],
  schema: schemaOf{{ pascalCase modelName }}PatchDTO,
  action: input => (async ({{#if i18n}}locale: AppLocale, {{/if}}{{ camelCase modelName }}Id: {{ pascalCase modelName }}DTO["id"], fromList: boolean) => {
    try {
      await patch{{ pascalCase modelName }}({{ camelCase modelName }}Id, input);
    } catch (error) {
      if (error === "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX") {
        displayMessage("error", error);
      }
      throw error;
    }
    updateTag(`getSingle{{ pascalCase modelName }}(${ {{~ camelCase modelName }}Id})`);
    {{#if i18n}}
    return redirect({
      locale,
      href: fromList ? "/{{ kebabCase modelName "plural" }}" : {
        pathname: "/{{ kebabCase modelName "plural" }}/[id]",
        params: {
          id: {{ camelCase modelName }}Id,
        },
      },
    });
    {{else}}
    return redirect(fromList ? "/{{ kebabCase modelName "plural" }}" : {
      pathname: "/{{ kebabCase modelName "plural" }}/[id]",
      params: {
        id: {{ camelCase modelName }}Id,
      },
    });
    {{/if}}
  }),
});

export const delete{{ pascalCase modelName }} = defineFormAction({
  middlewares: [mustBeLoggedIn],
  schema: z.object({}),
  action: () => (async ({{ camelCase modelName }}Id: {{ pascalCase modelName }}DTO["id"]) => {
    try {
      await destroy{{ pascalCase modelName }}({{ camelCase modelName }}Id);
    } catch (error) {
      if (error === "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX") {
        displayMessage("error", error);
      }
      throw error;
    }
    updateTag("get{{ pascalCase modelName }}Ids(...)");
    displayMessage("success", "DONE");
  }),
});
