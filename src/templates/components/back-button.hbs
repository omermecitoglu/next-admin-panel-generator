"use client";
import { faChevronLeft } from "@fortawesome/free-solid-svg-icons/faChevronLeft";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { useTranslations } from "next-intl";
import { type ComponentProps, useEffect, useState } from "react";
import Button from "~/components/ui/Button";
import { Link, useRouter } from "~/i18n/routing";

type BackButtonProps = Omit<ComponentProps<typeof Button>, "children" | "onClick" | "render" | "nativeButton"> & {
  fallback: ComponentProps<typeof Link>["href"],
};

const BackButton = ({
  fallback,
  ...otherProps
}: BackButtonProps) => {
  const t = useTranslations("BackButton");
  const router = useRouter();
  const [usingFallback, setUsingFallback] = useState(true);

  useEffect(() => {
    const referredByOrigin = !document.referrer.length || document.referrer.startsWith(window.location.origin);
    setUsingFallback(!referredByOrigin || window.history.length < 2);
  }, []);

  const WrapperButton = ({ children }: ComponentProps<"button">) => (usingFallback ? (
    <Button render={<Link href={fallback} />} nativeButton={false} {...otherProps}>
      {children}
    </Button>
  ) : (
    <Button onClick={router.back} {...otherProps}>
      {children}
    </Button>
  ));

  return (
    <WrapperButton>
      <FontAwesomeIcon icon={faChevronLeft} size="lg" />
      {" "}
      {t("label")}
    </WrapperButton>
  );
};

export default BackButton;
