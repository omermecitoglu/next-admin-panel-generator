import { faCheck } from "@fortawesome/pro-solid-svg-icons/faCheck";
import { faPenToSquare } from "@fortawesome/pro-solid-svg-icons/faPenToSquare";
import { faSpinner } from "@fortawesome/pro-solid-svg-icons/faSpinner";
import { faTrashCan } from "@fortawesome/pro-solid-svg-icons/faTrashCan";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { Tdx } from "@omer-x/tailwind-ui-kit/table";
{{#if i18n}}
import { useTranslations } from "next-intl";
{{/if}}
import { destroy{{ pascalCase modelName "singular" }} } from "~/actions/{{ kebabCase modelName "singular" }}";
import NeatTable from "~/components/NeatTable";
import DeleteDialogTrigger from "~/components/tmp/admin/DeleteDialogTrigger";
import List from "~/components/tmp/admin/List";
import Button from "~/components/ui/Button";
{{#if i18n}}
import { Link } from "~/i18n/routing";
{{else}}
import Link from "next/link";
{{/if}}

type {{ pascalCase modelName "singular" }}ListProps = {
  collection: {{ pascalCase modelName "singular" }}DTO[],
  userCanEdit: boolean,
  userCanDelete: boolean,
};

const {{ pascalCase modelName "singular" }}List = ({
  collection,
  userCanEdit,
  userCanDelete,
}: {{ pascalCase modelName "singular" }}ListProps) => {
  {{#if i18n}}
  const t = useTranslations("{{ pascalCase modelName "singular" }}");
  const fields = useTranslations("{{ pascalCase modelName "singular" }}Fields");
  {{/if}}
  return (
    <List
      deleteDialog=\{{
        title: {{#if i18n}}t("delete.title"){{else}}"Delete"{{/if}},
        warningText: {{#if i18n}}t("delete.description"){{else}}"Are you sure?"{{/if}},
        closeButton: (
          <Button variant="secondary">
            {{#if i18n}}
            {t("delete.cancel")}
            {{else}}
            Cancel
            {{/if}}
          </Button>
        ),
      }}
      deleteAction={destroy{{ pascalCase modelName "singular" ~}} }
      deleteActionButton=\{{
        ready: ((
          <Button variant="destructive">
            <FontAwesomeIcon icon={faCheck} size="lg" />
            {{#if i18n}}
            {t("delete.confirm")}
            {{else}}
            Delete
            {{/if}}
          </Button>
        )),
        pending: (
          <Button variant="destructive" disabled>
            <FontAwesomeIcon icon={faSpinner} size="lg" className="fa-spin" />
            {{#if i18n}}
            {t("delete.confirm")}
            {{else}}
            Delete
            {{/if}}
          </Button>
