{{#if i18n}}
import { useTranslations } from "next-intl";
{{else}}
import DataTable from "@omer-x/bs-ui-kit/DataTable";
import Link from "next/link";
{{/if}}
import { destroy{{ pascalCase modelName "singular" }} } from "~/actions/{{ kebabCase modelName "singular" }}";
{{#if i18n}}
import AdminTable from "~/components/AdminTable";
import { type AppLocale, Link } from "~/i18n/routing";
{{/if}}

type {{ pascalCase modelName "singular" }}ListProps = {
  collection: {{ pascalCase modelName "singular" }}DTO[],
  userCanEdit: boolean,
  userCanDelete: boolean,
  {{#if i18n}}
  pageLocale: AppLocale,
  {{/if}}
};

const {{ pascalCase modelName "singular" }}List = ({
  collection,
  userCanEdit,
  userCanDelete,
  {{#if i18n}}
  pageLocale,
  {{/if}}
}: {{ pascalCase modelName "singular" }}ListProps) => {
  {{#if i18n}}
  const t = useTranslations("{{ pascalCase modelName "singular" }}");
  {{/if}}
  return (
    {{#if i18n}}
    <AdminTable
    {{else}}
    <DataTable
      link={Link}
    {{/if}}
      collection={collection}
      primaryKey="id"
      schema=\{{
        name: {
          {{#if i18n}}
          header: t("fields.name"),
          {{else}}
          header: "Name",
          {{/if}}
          wrapper: (value, primaryKey) => <Link href={`{{ subPath }}/{{ kebabCase modelName "plural" }}/${primaryKey}`}>{value}</Link>,
        },
      }}
      editLink={userCanEdit ? (pk => `{{ subPath }}/{{ kebabCase modelName "plural" }}/${pk}/edit?r=list`) : undefined}
      destroyAction={async (pk, fd) => {
        "use server";
        await destroy{{ pascalCase modelName "singular" }}.bind(null, pageLocale)(pk, {}, fd);
      }}
      {{#if i18n}}
      destroyWarningTitle={t("delete.title")}
      destroyWarningDescription={t("delete.description")}
      {{else}}
      destroyWarningTitle="Delete {{ capitalCase modelName "singular" }}"
      destroyWarningDescription="Are you sure you want to delete this {{ noCase modelName "singular" }}?"
      destroyConfirmText="Confirm"
      destroyCancelText="Cancel"
      {{/if}}
      destroyDisabled={!userCanDelete}
    />
  );
};

export default {{ pascalCase modelName "singular" }}List;
