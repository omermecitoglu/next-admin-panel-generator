      <NeatTable>
        <thead>
          <tr>
            {{#if i18n}}
            <th>{fields("name")}</th>
            {{else}}
            <th>Name</th>
            {{/if}}
            <th>&nbsp;</th>
          </tr>
        </thead>
        <tbody>
          {collection.map({{ camelCase modelName "singular" }} => (
            <tr key={ {{~ camelCase modelName "singular" }}.id}>
              <Tdx>{ {{~ camelCase modelName "singular" }}.name}</Tdx>
              <td className="py-0!">
                <div className="flex gap-1">
                  <Button
                    size="xs"
                    render={!userCanEdit ? undefined : (
                      <Link
                        {{#if i18n}}
                        href=\{{
                          pathname: "{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit",
                          params: { id: {{ camelCase modelName "singular" }}.id },
                          query: { r: "list" },
                        }}
                        {{else}}
                        href={`{{ subPath }}/{{ kebabCase modelName "plural" }}/${ {{~ camelCase modelName "singular" }}.id}/edit?r=list`}
                        {{/if}}
                      />
                    )}
                    nativeButton={!userCanEdit}
                    disabled={userCanEdit ? undefined : true}
                  >
                    <FontAwesomeIcon icon={faPenToSquare} size="lg" />
                  </Button>
                  <DeleteDialogTrigger
                    itemId={ {{~ camelCase modelName "singular" }}.id}
                    render={(
                      <Button size="xs" variant="destructive">
                        <FontAwesomeIcon icon={faTrashCan} size="lg" />
                      </Button>
                    )}
                    disabled={!userCanDelete}
                  />
                </div>
              </td>
            </tr>
          ))}
