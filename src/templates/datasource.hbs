import "server-only";
import { cacheTag } from "next/cache";
import { getAllConcurrently } from "./utils/all";

// eslint-disable-next-line @typescript-eslint/no-empty-object-type
interface SearchFilters {
}

export async function getSingle{{ pascalCase modelName }}({{ camelCase modelName }}Id: {{ pascalCase modelName }}DTO["id"]) {
  "use cache";
  cacheTag(`getSingle{{ pascalCase modelName }}(${ {{~ camelCase modelName }}Id})`);
  const { success, content } = await get{{ pascalCase modelName }}({{ camelCase modelName }}Id);
  if ("errorCode" in content) {
    switch (content.errorCode) {
      case "{{ constantCase modelName }}_NOT_FOUND":
      case "UNKNOWN_ERROR":
        throw new Error(content.errorCode);
    }
  }
  if (!success) throw new Error("get{{ pascalCase modelName }} was unsuccessful");
  return content;
}

export async function get{{ pascalCase modelName }}Ids(
  limit: number,
  offset: number,
  filters: SearchFilters = {},
) {
  const { success, content } = await find{{ pascalCase modelName }}Ids({
    limit,
    offset,
    ...filters,
  });
  if ("errorCode" in content) {
    switch (content.errorCode) {
      case "BAD_REQUEST":
      case "UNKNOWN_ERROR":
        throw new Error(content.errorCode);
    }
  }
  if (!success) throw new Error("find{{ pascalCase modelName }}Ids was unsuccessful");
  return content;
}

export async function listOf{{ pascalCase modelName "plural" }}(
  limit: number,
  offset: number,
  filters: SearchFilters = {},
) {
  "use cache";
  cacheTag(`listOf{{ pascalCase modelName "plural" }}(${limit}, ${offset}, ${JSON.stringify(filters)})`);
  const list = await get{{ pascalCase modelName }}Ids(limit, offset, filters);
  return {
    totalItems: list.pagination.total,
    items: await Promise.all(list.ids.map(id => getSingle{{ pascalCase modelName }}(id))),
  };
}

export async function getAll{{ pascalCase modelName "plural" }}() {
  "use cache";
  cacheTag("getAll{{ pascalCase modelName "plural" }}()");
  return await getAllConcurrently(get{{ pascalCase modelName }}Ids, getSingle{{ pascalCase modelName }});
}
