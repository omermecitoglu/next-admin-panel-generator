import PageSection from "@omer-x/bs-ui-kit/PageSection";
{{#if i18n}}
import { getTranslations, setRequestLocale } from "next-intl/server";
{{/if}}
import { create{{ pascalCase modelName "singular" }} } from "~/actions/{{ kebabCase modelName "singular" }}";
import BackButton from "~/components/BackButton";
import {{ pascalCase modelName "singular" }}Form from "~/components/admin/{{ kebabCase modelName "plural" }}/{{ pascalCase modelName "singular" }}Form";
{{#if i18n}}
import type { AppLocale } from "~/i18n/routing";
{{/if}}

type Create{{ pascalCase modelName "singular" }}PageProps = {
  {{#if i18n}}
  params: Promise<{ locale: AppLocale }>,
  {{else}}
  params: Promise<unknown>,
  {{/if}}
};

const Create{{ pascalCase modelName "singular" }}Page = async ({
  params,
}: Create{{ pascalCase modelName "singular" }}PageProps) => {
  {{#if i18n}}
  const { locale } = await params;
  {{else}}
  const pageParams = await params;
  {{/if}}
  {{#if i18n}}
  setRequestLocale(locale);
  {{/if}}
  const [
    {{#if i18n}}
    t,
    {{/if}}
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCase modelName "singular" }}"),
    {{/if}}
  ]);
  return (
    <PageSection
      {{#if i18n}}
      title={t("create.title")}
      {{else}}
      title="New {{ capitalCase modelName "singular" }}"
      {{/if}}
      toolbar={(
        <BackButton fallback="{{ subPath }}/{{ kebabCase modelName "plural" }}" />
      )}
    >
      <{{ pascalCase modelName "singular" }}Form action={create{{ pascalCase modelName "singular" }}.bind(null, locale)} />
    </PageSection>
  );
};

export default Create{{ pascalCase modelName "singular" }}Page;
