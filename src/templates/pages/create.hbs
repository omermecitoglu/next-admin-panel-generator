{{#if i18n}}
import { hasLocale } from "next-intl";
import { getTranslations, setRequestLocale } from "next-intl/server";
{{/if}}
import { create{{ pascalCase modelName "singular" }} } from "~/actions/{{ kebabCase modelName "singular" }}";
import BackButton from "~/components/BackButton";
import {{ pascalCase modelName "singular" }}Form from "~/components/admin/{{ kebabCase modelName "plural" }}/{{ pascalCase modelName "singular" }}Form";
import PageSection from "~/components/tmp/PageSection";
{{#if i18n}}
import { notFound, routing } from "~/i18n/routing";
{{/if}}

{{#if i18n}}
export default async function(page: PageProps<"/[locale]{{ subPath }}/{{ kebabCase modelName "plural" }}/new">) {
  const { locale } = await page.params;
  if (!hasLocale(routing.locales, locale)) notFound();
  setRequestLocale(locale);
{{else}}
export default async function(page: PageProps<"{{ subPath }}/{{ kebabCase modelName "plural" }}/new">) {
  const pageParams = await page.params;
{{/if}}
  const [
    {{#if i18n}}
    t,
    {{/if}}
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCase modelName "singular" }}"),
    {{/if}}
  ]);
  return (
    <PageSection
      {{#if i18n}}
      title={t("create.title")}
      {{else}}
      title="New {{ capitalCase modelName "singular" }}"
      {{/if}}
      toolbar={(
        <BackButton fallback="{{ subPath }}/{{ kebabCase modelName "plural" }}" />
      )}
    >
      <{{ pascalCase modelName "singular" }}Form
        purpose="create"
        schema={schemaOfNew{{ pascalCase modelName "singular" }}DTO}
        action={createProduct.bind(null, locale)}
      />
    </PageSection>
  );
}
