import { connection } from "next/server";
{{#if i18n}}
import { hasLocale } from "next-intl";
import { getTranslations, setRequestLocale } from "next-intl/server";
{{/if}}
import { create{{ pascalCase modelName }} } from "~/actions/{{ kebabCase modelName }}";
import BackButton from "~/components/BackButton";
import {{ pascalCase modelName }}Form from "~/components/admin/{{ kebabCase modelName "plural" }}/{{ pascalCase modelName }}Form";
import PageSection from "~/components/tmp/PageSection";
{{#if i18n}}
import { notFound, routing } from "~/i18n/routing";
{{/if}}

{{#if i18n}}
export default async function(page: PageProps<"/[locale]{{ subPath }}/{{ kebabCase modelName "plural" }}/new">) {
{{else}}
export default async function(page: PageProps<"{{ subPath }}/{{ kebabCase modelName "plural" }}/new">) {
{{/if}}
  const [
    _,
    {{#if i18n}}
    { locale },
    {{else}}
    __,
    {{/if}}
  ] = await Promise.all([
    connection(),
    page.params,
  ]);
  {{#if i18n}}
  if (!hasLocale(routing.locales, locale)) notFound();
  setRequestLocale(locale);
  {{/if}}
  const [
    {{#if i18n}}
    t,
    {{/if}}
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCase modelName }}"),
    {{/if}}
  ]);
  return (
    <PageSection
      {{#if i18n}}
      title={t("create.title")}
      {{else}}
      title="New {{ capitalCase modelName }}"
      {{/if}}
      toolbar={(
        <BackButton fallback="{{ subPath }}/{{ kebabCase modelName "plural" }}" />
      )}
    >
      <{{ pascalCase modelName }}Form
        purpose="create"
        schema={schemaOfNew{{ pascalCase modelName }}DTO}
        action={create{{ pascalCase modelName }}.bind(null{{#if i18n}}, locale{{/if}})}
      />
    </PageSection>
  );
}
