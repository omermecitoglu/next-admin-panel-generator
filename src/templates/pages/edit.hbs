import { parseSearchParams } from "@omer-x/next-utils/search-params";
{{#if i18n}}
import { hasLocale } from "next-intl";
import { getTranslations, setRequestLocale } from "next-intl/server";
{{/if}}
import z from "zod";
import { update{{ pascalCase modelName }} } from "~/actions/{{ kebabCase modelName }}";
import BackButton from "~/components/BackButton";
import {{ pascalCase modelName }}Form from "~/components/admin/{{ kebabCase modelName "plural" }}/{{ pascalCase modelName }}Form";
import PageSection from "~/components/tmp/PageSection";
import { getSingle{{ pascalCase modelName }} } from "~/data/{{ kebabCase modelName "plural" }}";
{{#if i18n}}
import { notFound, routing } from "~/i18n/routing";
{{/if}}

{{#if i18n}}
export default async function(page: PageProps<"/[locale]{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit">) {
{{else}}
export default async function(page: PageProps<"{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit">) {
{{/if}}
  const [
    { {{#if i18n}}locale, {{/if}}id: {{camelCase modelName "singular"}}Id },
    { r },
  ] = await Promise.all([
    page.params,
    parseSearchParams(page.searchParams, z.object({
      r: z.literal("list").nullable().optional(),
    }), notFound),
  ]);
  {{#if i18n}}
  if (!hasLocale(routing.locales, locale)) notFound();
  setRequestLocale(locale);
  {{/if}}
  const fromList = r === "list";
  const [
    {{#if i18n}}
    t,
    {{/if}}
    {{ camelCase modelName }},
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCase modelName }}"),
    {{/if}}
    getSingle{{ pascalCase modelName }}({{camelCase modelName "singular"}}Id),
  ]);
  return (
    <PageSection
      {{#if i18n}}
      title={t("edit.title")}
      {{else}}
      title="Edit {{ capitalCase modelName }}"
      {{/if}}
      toolbar={(
        <BackButton
          fallback={fromList ? "{{ subPath }}/{{ kebabCase modelName "plural" }}" : {
            pathname: "{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]",
            params: {
              id: {{ camelCase modelName }}.id,
            },
          }}
        />
      )}
    >
      <{{ pascalCase modelName }}Form
        purpose="edit"
        schema={schemaOf{{ pascalCase modelName }}PatchDTO}
        action={update{{ pascalCase modelName }}.bind(null{{#if i18n}}, locale{{/if}}, {{ camelCase modelName }}.id, fromList)}
        defaultValues={ {{~ camelCase modelName "singular" ~}} }
      />
    </PageSection>
  );
}
