{{#if i18n}}
import { hasLocale } from "next-intl";
import { getTranslations, setRequestLocale } from "next-intl/server";
{{/if}}
import { update{{ pascalCase modelName "singular" }} } from "~/actions/{{ kebabCase modelName "singular" }}";
import BackButton from "~/components/BackButton";
import {{ pascalCase modelName "singular" }}Form from "~/components/admin/{{ kebabCase modelName "plural" }}/{{ pascalCase modelName "singular" }}Form";
import PageSection from "~/components/tmp/PageSection";
import { getSingle{{ pascalCase modelName "singular" }} } from "~/data/{{ kebabCase modelName "plural" }}";
{{#if i18n}}
import { notFound, routing } from "~/i18n/routing";
{{/if}}

{{#if i18n}}
export default async function(page: PageProps<"/[locale]{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit">) {
  const { locale, id: {{camelCase modelName "singular"}}Id } = await page.params;
{{else}}
export default async function(page: PageProps<"{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit">) {
  const { id: {{camelCase modelName "singular"}}Id } = await page.params;
{{/if}}
  const { r } = await page.searchParams;
  {{#if i18n}}
  if (!hasLocale(routing.locales, locale)) notFound();
  setRequestLocale(locale);
  {{/if}}
  const fromList = r === "list";
  const [
    {{#if i18n}}
    t,
    {{/if}}
    {{ camelCase modelName "singular" }},
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCase modelName "singular" }}"),
    {{/if}}
    getSingle{{ pascalCase modelName "singular" }}({{camelCase modelName "singular"}}Id),
  ]);
  return (
    <PageSection
      {{#if i18n}}
      title={t("edit.title")}
      {{else}}
      title="Edit {{ capitalCase modelName "singular" }}"
      {{/if}}
      toolbar={(
        <BackButton
          fallback={fromList ? "{{ subPath }}/{{ kebabCase modelName "plural" }}" : {
            pathname: "{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]",
            params: {
              id: {{ camelCase modelName "singular" }}.id,
            },
          }}
        />
      )}
    >
      <{{ pascalCase modelName "singular" }}Form
        purpose="edit"
        schema={schemaOf{{ pascalCase modelName "singular" }}PatchDTO}
        action={update{{ pascalCase modelName "singular" }}.bind(null{{#if i18n}}, locale{{/if}}, {{ camelCase modelName "singular" }}.id, fromList)}
        defaultValues={ {{~ camelCase modelName "singular" ~}} }
      />
    </PageSection>
  );
}
