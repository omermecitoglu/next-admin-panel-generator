import CreateButton from "@omer-x/bs-ui-kit/CreateButton";
import PageSection from "@omer-x/bs-ui-kit/PageSection";
import { unauthorized } from "next/navigation";
{{#if i18n}}
import { getTranslations, setRequestLocale } from "next-intl/server";
{{else}}
import Link from "next/link";
{{/if}}
import {{ pascalCaseSingular }}List from "~/components/admin/{{ kebabCasePlural }}/{{ pascalCaseSingular }}List";
import { getSession } from "~/core/session";
import { getAll{{ pascalCasePlural }} } from "~/data/{{ kebabCasePlural }}";
import getUserPerms from "~/data/user-perms";
{{#if i18n}}
import { type AppLocale, Link } from "~/i18n/routing";
{{/if}}

type {{ pascalCaseSingular }}ListPageProps = {
  {{#if i18n}}
  params: Promise<{ locale: AppLocale }>,
  {{else}}
  params: Promise<unknown>,
  {{/if}}
};

const {{ pascalCaseSingular }}ListPage = async ({
  params,
}: {{ pascalCaseSingular }}ListPageProps) => {
  {{#if i18n}}
  const { locale } = await params;
  {{else}}
  const pageParams = await params;
  {{/if}}
  {{#if i18n}}
  setRequestLocale(locale);
  {{/if}}
  const [
    {{#if i18n}}
    t,
    {{/if}}
    session,
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCaseSingular }}"),
    {{/if}}
    getSession(),
  ]);
  if (!session.userId) unauthorized();
  const [
    perms,
    {{ camelCasePlural }},
  ] = await Promise.all([
    getUserPerms(session.userId),
    getAll{{ pascalCasePlural }}(),
  ]);
  return (
    <PageSection
      {{#if i18n}}
      title={t("list.title")}
      {{else}}
      title="{{ capitalCasePlural }}"
      {{/if}}
      toolbar={(
        <>
          {perms.includes("can_create_{{ snakeCasePlural }}") && (
            <CreateButton
              as={Link}
              {{#if i18n}}
              text={t("create.title")}
              {{else}}
              text="New {{ capitalCaseSingular }}"
              {{/if}}
              href="{{ subPath }}/{{ kebabCasePlural }}/new"
              size="sm"
            />
          )}
        </>
      )}
    >
      <{{ pascalCaseSingular }}List
        collection={ {{~camelCasePlural~}} }
        userCanEdit={perms.includes("can_edit_{{ snakeCasePlural }}")}
        userCanDelete={perms.includes("can_delete_{{ snakeCasePlural }}")}
        {{#if i18n}}
        pageLocale={locale}
        {{/if}}
      />
    </PageSection>
  );
};

export default {{ pascalCaseSingular }}ListPage;
