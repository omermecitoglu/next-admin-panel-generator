import { faPlus } from "@fortawesome/pro-solid-svg-icons/faPlus";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { parseSearchParams } from "@omer-x/next-utils/search-params";
import { Pagination } from "@omer-x/tailwind-ui-kit/page";
import NextLink from "next/link";
import { unauthorized } from "next/navigation";
{{#if i18n}}
import { hasLocale } from "next-intl";
import { getTranslations, setRequestLocale } from "next-intl/server";
{{else}}
import Link from "next/link";
{{/if}}
import z from "zod";
import {{ pascalCase modelName "singular" }}List from "~/components/admin/{{ kebabCase modelName "plural" }}/{{ pascalCase modelName "singular" }}List";
import PageSection from "~/components/tmp/PageSection";
import Button from "~/components/ui/Button";
import { getSession } from "~/core/session";
import { listOf{{ pascalCase modelName "plural" }} } from "~/data/{{ kebabCase modelName "plural" }}";
import getUserPerms from "~/data/user-perms";
{{#if i18n}}
import { Link, notFound, routing } from "~/i18n/routing";
{{else}}
import { notFound } from "next/navigation";
{{/if}}

{{#if i18n}}
export default async function(page: PageProps<"/[locale]{{ subPath }}/{{ kebabCase modelName "plural" }}">) {
  const [
    { locale },
    searchParams,
  ] = await Promise.all([
    page.params,
    parseSearchParams(page.searchParams, z.object({
      page: z.coerce.number().default(1),
    }), notFound),
  ]);
  if (!hasLocale(routing.locales, locale)) notFound();
  setRequestLocale(locale);
{{else}}
export default async function(page: PageProps<"{{ subPath }}/{{ kebabCase modelName "plural" }}">) {
  const [
    searchParams
  ] = await Promise.all([
    parseSearchParams(page.searchParams, z.object({
      page: z.coerce.number().default(1),
    }), notFound),
  ]);
{{/if}}

  const itemsPerPage = 100;
  const offset = (searchParams.page - 1) * itemsPerPage;

  const [
    {{#if i18n}}
    t,
    {{/if}}
    session,
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCase modelName "singular" }}"),
    {{/if}}
    getSession(),
  ]);
  if (!session.userId) unauthorized();
  const [
    perms,
    { totalItems: numberOf{{ pascalCase modelName "plural" }}, items: {{ camelCase modelName "plural" }} },
  ] = await Promise.all([
    getUserPerms(session.userId),
    listOf{{ pascalCase modelName "plural" }}(itemsPerPage, offset),
  ]);
  return (
    <PageSection
      {{#if i18n}}
      title={t("list.title")}
      {{else}}
      title="{{ capitalCase modelName "plural" }}"
      {{/if}}
      toolbar={(
        <>
          {perms.includes("can_create_{{ snakeCase modelName "plural" }}") && (
            <Button render={<Link href="{{ subPath }}/{{ kebabCase modelName "plural" }}/new" />} nativeButton={false}>
              <FontAwesomeIcon icon={faPlus} size="lg" />
              {{#if i18n}}
              {t("create.title")}
              {{else}}
              New {{ capitalCase modelName "singular" }}
              {{/if}}
            </Button>
          )}
        </>
      )}
    >
      <{{ pascalCase modelName "singular" }}List
        collection={ {{~camelCase modelName "plural"~}} }
        userCanEdit={perms.includes("can_edit_{{ snakeCase modelName "plural" }}")}
        userCanDelete={perms.includes("can_delete_{{ snakeCase modelName "plural" }}")}
      />
      {numberOf{{ pascalCase modelName "plural" }} > itemsPerPage && (
        <>
          <hr className="my-4" />
          <Pagination
            totalItems={numberOf{{ pascalCase modelName "plural" ~}} }
            itemsPerPage={itemsPerPage}
            currentPage={searchParams.page}
            queryParams={searchParams}
            renderButton={(
              <Button size="xs" />
            )}
            renderLink={( // @ts-expect-error href will be provided by pagination
              <Button size="xs" render={<NextLink replace scroll={false} />} nativeButton={false} />
            )}
          />
        </>
      )}
    </PageSection>
  );
}
