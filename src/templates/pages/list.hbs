import CreateButton from "@omer-x/bs-ui-kit/CreateButton";
import PageSection from "@omer-x/bs-ui-kit/PageSection";
import { unauthorized } from "next/navigation";
{{#if i18n}}
import { getTranslations, setRequestLocale } from "next-intl/server";
{{else}}
import Link from "next/link";
{{/if}}
import {{ pascalCase modelName "singular" }}List from "~/components/admin/{{ kebabCase modelName "plural" }}/{{ pascalCase modelName "singular" }}List";
import { getSession } from "~/core/session";
import { getAll{{ pascalCase modelName "plural" }} } from "~/data/{{ kebabCase modelName "plural" }}";
import getUserPerms from "~/data/user-perms";
{{#if i18n}}
import { type AppLocale, Link } from "~/i18n/routing";
{{/if}}

type {{ pascalCase modelName "singular" }}ListPageProps = {
  {{#if i18n}}
  params: Promise<{ locale: AppLocale }>,
  {{else}}
  params: Promise<unknown>,
  {{/if}}
};

const {{ pascalCase modelName "singular" }}ListPage = async ({
  params,
}: {{ pascalCase modelName "singular" }}ListPageProps) => {
  {{#if i18n}}
  const { locale } = await params;
  {{else}}
  const pageParams = await params;
  {{/if}}
  {{#if i18n}}
  setRequestLocale(locale);
  {{/if}}
  const [
    {{#if i18n}}
    t,
    {{/if}}
    session,
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCase modelName "singular" }}"),
    {{/if}}
    getSession(),
  ]);
  if (!session.userId) unauthorized();
  const [
    perms,
    {{ camelCase modelName "plural" }},
  ] = await Promise.all([
    getUserPerms(session.userId),
    getAll{{ pascalCase modelName "plural" }}(),
  ]);
  return (
    <PageSection
      {{#if i18n}}
      title={t("list.title")}
      {{else}}
      title="{{ capitalCase modelName "plural" }}"
      {{/if}}
      toolbar={(
        <>
          {perms.includes("can_create_{{ snakeCase modelName "plural" }}") && (
            <CreateButton
              as={Link}
              {{#if i18n}}
              text={t("create.title")}
              {{else}}
              text="New {{ capitalCase modelName "singular" }}"
              {{/if}}
              href="{{ subPath }}/{{ kebabCase modelName "plural" }}/new"
              size="sm"
            />
          )}
        </>
      )}
    >
      <{{ pascalCase modelName "singular" }}List
        collection={ {{~camelCase modelName "plural"~}} }
        userCanEdit={perms.includes("can_edit_{{ snakeCase modelName "plural" }}")}
        userCanDelete={perms.includes("can_delete_{{ snakeCase modelName "plural" }}")}
        {{#if i18n}}
        pageLocale={locale}
        {{/if}}
      />
    </PageSection>
  );
};

export default {{ pascalCase modelName "singular" }}ListPage;
