import { faPencil } from "@fortawesome/free-solid-svg-icons/faPencil";
import InfoTable from "@omer-x/bs-ui-kit/InfoTable";
import LinkButton from "@omer-x/bs-ui-kit/LinkButton";
import PageSection from "@omer-x/bs-ui-kit/PageSection";
{{#if i18n}}
import { getTranslations, setRequestLocale } from "next-intl/server";
import { hasLocale } from "next-intl";
{{else}}
import Link from "next/link";
{{/if}}
import BackButton from "~/components/BackButton";
import { getSingle{{ pascalCase modelName "singular" }} } from "~/data/{{ kebabCase modelName "plural" }}";
{{#if i18n}}
import { Link, notFound, routing } from "~/i18n/routing";
{{/if}}

{{#if i18n}}
export default async function(page: PageProps<"/[locale]{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit">) {
  const { locale, id: {{camelCase modelName "singular"}}Id } = await page.params;
  if (!hasLocale(routing.locales, locale)) notFound();
  setRequestLocale(locale);
{{else}}
export default async function(page: PageProps<"{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit">) {
  const { id: {{camelCase modelName "singular"}}Id } = await page.params;
{{/if}}
  const [
    {{#if i18n}}
    t,
    {{/if}}
    {{ camelCase modelName "singular" }},
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCase modelName "singular" }}"),
    {{/if}}
    getSingle{{ pascalCase modelName "singular" }}({{camelCase modelName "singular"}}Id),
  ]);
  return (
    <PageSection
      title={ {{~camelCase modelName "singular"~}} .name}
      toolbar={(
        <>
          {perms.includes("can_create_{{ snakeCase modelName "plural" }}") && (
            <LinkButton
              as={Link}
              icon={faPencil}
              {{#if i18n}}
              text={t("edit.title")}
              {{else}}
              text="Edit {{ capitalCase modelName "singular" }}"
              {{/if}}
              href={`{{ subPath }}/{{ kebabCase modelName "plural" }}/${ {{~camelCase modelName "singular"~}} .id}/edit`}
              size="sm"
            />
          )}
          <BackButton fallback="{{ subPath }}/{{ kebabCase modelName "plural" }}" />
        </>
      )}
    >
      <InfoTable
        source={ {{~camelCase modelName "singular"~}} }
        primaryKey="id"
        schema=\{{
          id: {
            header: "ID",
            long: true,
          },
        }}
      />
    </PageSection>
  );
};
