import { faPencil } from "@fortawesome/free-solid-svg-icons/faPencil";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { Tdx } from "@omer-x/tailwind-ui-kit/table";
import { unauthorized } from "next/navigation";
{{#if i18n}}
import { hasLocale } from "next-intl";
import { getTranslations, setRequestLocale } from "next-intl/server";
{{else}}
import Link from "next/link";
{{/if}}
import BackButton from "~/components/BackButton";
import PageSection from "~/components/tmp/PageSection";
import Button from "~/components/ui/Button";
import { getSession } from "~/core/session";
import { getSingle{{ pascalCase modelName "singular" }} } from "~/data/{{ kebabCase modelName "plural" }}";
import getUserPerms from "~/data/user-perms";
{{#if i18n}}
import { Link, notFound, routing } from "~/i18n/routing";
{{/if}}

{{#if i18n}}
export default async function(page: PageProps<"/[locale]{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit">) {
  const { locale, id: {{camelCase modelName "singular"}}Id } = await page.params;
  if (!hasLocale(routing.locales, locale)) notFound();
  setRequestLocale(locale);
{{else}}
export default async function(page: PageProps<"{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit">) {
  const { id: {{camelCase modelName "singular"}}Id } = await page.params;
{{/if}}
  const [
    {{#if i18n}}
    t,
    {{/if}}
    session,
  ] = await Promise.all([
    {{#if i18n}}
    getTranslations("{{ pascalCase modelName "singular" }}"),
    {{/if}}
    getSession(),
  ]);
  if (!session.userId) unauthorized();
  const [
    perms,
    {{ camelCase modelName "singular" }},
  ] = await Promise.all([
    getUserPerms(session.userId),
    getSingle{{ pascalCase modelName "singular" }}({{camelCase modelName "singular"}}Id),
  ]);
  return (
    <PageSection
      title={ {{~camelCase modelName "singular"~}} .name}
      toolbar={(
        <>
          {perms.includes("can_create_{{ snakeCase modelName "plural" }}") && (
            <Button
              size="sm"
              {{#if i18n}}
              render={<Link href=\{{ pathname: "{{ subPath }}/{{ kebabCase modelName "plural" }}/[id]/edit", params: { id: {{ camelCase modelName "singular" }}.id } }} />}
              {{else}}
              render={<Link href={`{{ subPath }}/{{ kebabCase modelName "plural" }}/${ {{~ camelCase modelName "singular" }}.id}/edit`} />}
              {{/if}}
              nativeButton={false}
            >
              <FontAwesomeIcon icon={faPencil} size="lg" />
              {{#if i18n}}
              {t("edit.title")}
              {{else}}
              Edit {{ capitalCase modelName "singular" }}
              {{/if}}
            </Button>
          )}
          <BackButton fallback="{{ subPath }}/{{ kebabCase modelName "plural" }}" />
        </>
      )}
    >
      <table className="w-full [&_td]:px-3 [&_td]:py-2 [&_th]:px-3 [&_th]:py-2">
        <tbody>
          <tr>
            <th>ID</th>
            <Tdx>{ {{~ camelCase modelName "singular" }}.id}</Tdx>
          </tr>
        </tbody>
      </table>
    </PageSection>
  );
}
